{
  "name": "tecnofix-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API REST de TecnoFix (Node.js + Express + MySQL)",
  "engines": { "node": ">=20.10" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "db:reset": "node scripts/init-db.js --drop",
    "db:seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/auth.test.js tests/permisos.test.js tests/asignacion.test.js tests/valoraciones.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
