# ---- Servidor ----
PORT=3000
NODE_ENV=development
# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# ---- MySQL local ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tecnofix
# Base separada para las pruebas automatizadas (se BORRA y recrea en cada corrida)
DB_NAME_TEST=tecnofix_test

# ---- Autenticacion ----
# Genere un valor largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
# Cookie de sesion: en local dejar asi. En produccion los valores por defecto son SameSite=none y SECURE=true.
# Si se definen manualmente en Railway, use COOKIE_SAMESITE=none y COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Datos iniciales (npm run db:seed / create-admin) ----
# Si ADMIN_PASSWORD queda vacio se genera una aleatoria y se guarda en seed-credentials.local.txt
ADMIN_EMAIL=admin@tecnofix.local
ADMIN_PASSWORD=
# Contrasena para tecnicos y cliente demo del seed. Vacio = aleatoria por usuario.
SEED_USER_PASSWORD=

# ---- Login social (PENDIENTE de configuracion; sin estas variables la API responde 501) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
