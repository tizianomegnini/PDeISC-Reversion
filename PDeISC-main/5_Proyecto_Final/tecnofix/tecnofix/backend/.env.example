# ---- Servidor ----
PORT=3000
NODE_ENV=development
# Origenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173

# ---- MySQL local ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tecnofix
# Base separada para las pruebas automatizadas (se BORRA y recrea en cada corrida)
DB_NAME_TEST=tecnofix_test

# ---- Autenticacion ----
# Genere un valor largo y aleatorio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=302550771d58e5d72307471981c6c55913c857d2a96f44e0417b445b07c7695837c6d585bba4b1cc00d06603d79b4d4c
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=12
# Cookie de sesion: en local dejar asi. En produccion los valores por defecto son SameSite=none y SECURE=true.
# Si se definen manualmente en Railway, use COOKIE_SAMESITE=none y COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---- Datos iniciales (npm run db:seed / create-admin) ----
# Si ADMIN_PASSWORD queda vacio se genera una aleatoria y se guarda en seed-credentials.local.txt
ADMIN_EMAIL=admin@tecnofix.local
ADMIN_PASSWORD=
# Contrasena para tecnicos y cliente demo del seed. Vacio = aleatoria por usuario.
SEED_USER_PASSWORD=

# ---- Login con Google ----
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL de callback exacta registrada en Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/google/callback

# ---- Login social (pendientes de implementar) ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/facebook/callback

# ---- Login con GitHub ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/social/github/callback
