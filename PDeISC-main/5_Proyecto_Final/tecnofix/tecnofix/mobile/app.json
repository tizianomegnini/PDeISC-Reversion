{
  "expo": {
    "name": "TecnoFix Soporte",
    "slug": "tecnofix-mobile",
    "version": "1.0.8",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "tecnofix",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/tecnofix-mark.png",
      "imageWidth": 180,
      "resizeMode": "contain",
      "backgroundColor": "#102A43"
    },
    "android": {
      "package": "com.tecnofix.app",
      "versionCode": 9,
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102A43"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#087E8B",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "81628f9d-bbcf-4a63-8b75-141cb2c4307a"
      }
    }
  }
}
