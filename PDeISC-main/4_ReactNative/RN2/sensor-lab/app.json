{
  "expo": {
    "name": "RN2",
    "slug": "rn2",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.tunombre.sensorlab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#101630",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "RN2 usa la cámara para tomar fotos y escanear códigos QR."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "RN2 usa tu ubicación para mostrar coordenadas."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "RN2 usa biometría para confirmar tu identidad."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bb8b09c7-7a84-423d-b65e-af8847758e56"
      }
    }
  }
}
