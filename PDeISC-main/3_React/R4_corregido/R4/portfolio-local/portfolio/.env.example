# Copiar a .env.local para desarrollo local. No subir secretos a Git.
# En Railway, crear un TCP Proxy para MySQL y usar el host y puerto públicos
# del proxy, no el dominio MYSQLHOST terminado en .railway.internal.
MYSQL_PUBLIC_URL=mysql://USUARIO:CONTRASENA@HOST_PUBLICO:PUERTO/BASE

# Credenciales de administrador para la API de Vercel.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD_HASH=pegar_aqui_el_hash_bcrypt
JWT_SECRET=generar_un_secreto_aleatorio_largo

# Opcional: activar solo si tu conexión MySQL exige TLS.
# MYSQL_SSL=true
