# Copiá este archivo como .env (cp .env.example .env) y completá tus datos.
# El archivo .env NO se sube a git ni se comparte: tiene tus contraseñas.

PORT=4000

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# La contraseña de TU MySQL. Si tu root no tiene contraseña (típico de XAMPP), dejala vacía.
DB_PASSWORD=
DB_NAME=usuarios_app

# --- JWT ---
# Secreto para firmar los tokens. Generá uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_random
JWT_EXPIRES_IN=2h

# --- CORS (opcional) ---
# Orígenes del front permitidos, separados por coma.
# Por defecto ya se aceptan http://localhost:5173 y http://localhost:5174.
# CORS_ORIGIN=https://mi-dominio.com
